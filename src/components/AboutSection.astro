---
const points = [
  {
    title: '100% auténticos',
    text: 'Importación directa desde Dubai.',
    image: 'https://images.unsplash.com/photo-1615634260167-c8cdede054de?q=80&w=1600&auto=format&fit=crop',
  },
  {
    title: 'Showroom',
    text: 'Ven a probar antes de elegir.',
    image: 'https://images.unsplash.com/photo-1662748716967-88fea581d239?q=80&w=1600&auto=format&fit=crop',
  },
  {
    title: 'Asesoría personal',
    text: 'Te ayudamos a encontrar tu fragancia.',
    image: 'https://images.unsplash.com/photo-1622952826417-6212791163ab?q=80&w=1600&auto=format&fit=crop',
  },
  {
    title: 'Novedades y exclusivos',
    text: 'Siempre tendencias y piezas únicas.',
    image: 'https://images.unsplash.com/photo-1615108395437-df128ad79e80?q=80&w=1600&auto=format&fit=crop',
  },
];
---

<section id="quienes-somos" class="about-section" aria-labelledby="about-heading">
  <div class="about-inner">
    <header class="about-header">
      <h2 id="about-heading" class="about-title">
        Por qué elegir nuestras fragancias
      </h2>
      <p class="about-desc">
        Conectamos la perfumería de Oriente Medio con Colombia: autenticidad, trato cercano y variedad.
      </p>
    </header>

    <ul class="about-grid">
      {points.map(({ title, text, image }) => (
        <li class="about-card">
          <div class="about-card-media" aria-hidden="true">
            <img
              src={image}
              alt=""
              class="about-card-img"
              loading="lazy"
              fetchpriority="low"
            />
            <div class="about-card-overlay"></div>
          </div>
          <div class="about-card-body">
            <h3 class="about-card-title">{title}</h3>
            <p class="about-card-text">{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-section {
    scroll-margin-top: 5rem;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem 4rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0f2626 0%, #132d2d 35%, #1a3a3a 100%);
  }

  .about-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .about-inner {
      gap: 3.5rem;
      padding: 0 1.5rem;
    }
  }

  .about-header {
    max-width: 40rem;
    margin: 0 auto;
  }

  .about-title {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  .about-desc {
    font-size: clamp(0.9375rem, 2.2vw, 1.125rem);
    color: #cbd5e1;
    margin: 0;
    line-height: 1.6;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
  }

  .about-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    width: 100%;
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
      max-width: 52rem;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width: 80rem;
      gap: 2rem;
    }
  }

  .about-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1.75rem;
    min-height: 11rem;
    border-radius: 1.25rem;
    background: transparent;
    border: 1px solid rgba(193, 154, 107, 0.25);
    overflow: hidden;
    position: relative;
    isolation: isolate;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
  }

  @media (min-width: 640px) {
    .about-card {
      padding: 3rem 2rem;
      min-height: 13rem;
    }
  }

  @media (min-width: 768px) {
    .about-card {
      padding: 3.5rem 2rem;
      min-height: 14rem;
    }
  }

  @media (min-width: 1024px) {
    .about-card {
      padding: 4rem 2rem;
      min-height: 16rem;
    }
  }

  .about-card:hover {
    border-color: rgba(193, 154, 107, 0.6);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(193, 154, 107, 0.16);
    transform: translateY(-4px);
  }

  .about-card-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .about-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    filter: saturate(1.1);
  }

  .about-card-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
        circle at top center,
        rgba(255, 255, 255, 0.08) 0%,
        transparent 40%
      ),
      linear-gradient(
        180deg,
        rgba(15, 38, 38, 0.88) 0%,
        rgba(15, 38, 38, 0.8) 35%,
        rgba(15, 38, 38, 0.9) 100%
      );
    backdrop-filter: blur(6px);
  }

  .about-card-body {
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .about-card-title {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: #f8fafc;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .about-card-title {
      font-size: 1.375rem;
    }
  }

  @media (min-width: 1024px) {
    .about-card-title {
      font-size: 1.5rem;
    }
  }

  .about-card-text {
    font-size: clamp(0.9375rem, 1.8vw, 1.0625rem);
    color: #cbd5e1;
    margin: 0;
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .about-card-text {
      font-size: 1.0625rem;
    }
  }
</style>
